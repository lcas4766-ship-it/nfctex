
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Copiar texto NFC</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #eef8ff;
      font-family: Arial, sans-serif;
      padding: 20px;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 20px;
      width: 100%;
      max-width: 420px;
      text-align: center;
      box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    }

    h1 {
      color: #229bd1;
      font-size: 25px;
    }

    p {
      color: #64748b;
    }

    .texto {
      background: #f1f9ff;
      border: 1px solid #cceaff;
      padding: 20px;
      border-radius: 12px;
      margin: 25px 0;
      color: #334155;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      text-align: left;
    }

    button {
      background: #38b6ff;
      color: white;
      border: none;
      padding: 16px;
      width: 100%;
      border-radius: 12px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:active {
      background: #168ed0;
    }

    #mensaje {
      margin-top: 15px;
      color: #168653;
      font-weight: bold;
    }
  </style>
</head>

<body>
  <div class="card">
    <h1>📋 Copiar texto</h1>
    <p>Presiona el botón para copiar el contenido.</p>

    <div class="texto" id="texto">
Este es un texto de ejemplo.
Mañana lo cambiaremos por el definitivo.
    </div>

    <button onclick="copiarTexto()">
      📋 Copiar texto
    </button>

    <p id="mensaje" role="status"></p>
  </div>

  <script>
    async function copiarTexto() {
      const texto = document.getElementById("texto").innerText.trim();
      const mensaje = document.getElementById("mensaje");

      try {
        await navigator.clipboard.writeText(texto);
        mensaje.textContent = "✓ ¡Texto copiado!";
      } catch (error) {
        mensaje.textContent = "Selecciona el texto para copiarlo manualmente.";
      }
    }
  </script>
</body>
</html>
